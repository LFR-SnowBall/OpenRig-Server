set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SERVER_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

export PATH="${HOME}/.orbstack/bin:/Applications/OrbStack.app/Contents/MacOS/xbin:/opt/homebrew/bin:/usr/local/bin:$PATH"

WORKSPACES_DIR="${SERVER_DIR}/workspaces"
BACKUPS_DIR="${SERVER_DIR}/backups"
USERS_DB="${SERVER_DIR}/config/users.db"
mkdir -p "$WORKSPACES_DIR" "$BACKUPS_DIR" "${SERVER_DIR}/config"
touch "$USERS_DB"

CYAN="\033[96m"
GREEN="\033[92m"
YELLOW="\033[93m"
RED="\033[91m"
BOLD="\033[1m"
RESET="\033[0m"

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════════════════════╗"
    echo "║   🏢 OPENRIG SERVER — MULTI-TENANT WORKSTATION ORCHESTRATOR              ║"
    echo "║   By Linux Open Source S.A. de C.V.                                      ║"
    echo "╚══════════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

next_free_port() {
    local port=2201
    while grep -q ":${port}:" "$USERS_DB" 2>/dev/null || lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; do
        port=$((port + 1))
    done
    echo "$port"
}

cmd_user_create() {
    local username="${1:?Usage: rig-server user create <username> [--role fullstack] [--ram 4g] [--cpus 2] [--port 2201] [--ssh-key '<pubkey>']}"
    shift || true

    local role="fullstack"
    local ram="4g"
    local cpus="2"
    local port
    port=$(next_free_port)
    local ssh_key=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --role)    role="$2"; shift 2 ;;
            --ram)     ram="$2"; shift 2 ;;
            --cpus)    cpus="$2"; shift 2 ;;
            --port)    port="$2"; shift 2 ;;
            --ssh-key) ssh_key="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    # Default to host user's public key if none passed
    if [ -z "$ssh_key" ]; then
        if command -v ssh-add >/dev/null 2>&1 && ssh-add -L >/dev/null 2>&1; then
            ssh_key=$(ssh-add -L | head -n 1)
        elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
            ssh_key=$(cat "$HOME/.ssh/id_ed25519.pub")
        fi
    fi

    local container_name="openrig-user-${username}"
    local net_name="openrig-net-${username}"
    local user_ws="${WORKSPACES_DIR}/${username}"
    mkdir -p "$user_ws"

    echo -e "${CYAN}🚀 Provisioning isolated workstation for '${username}' (Role: ${role}, RAM: ${ram}, CPUs: ${cpus}, SSH Port: ${port})...${RESET}"

    docker network inspect "$net_name" >/dev/null 2>&1 || docker network create "$net_name" >/dev/null

    docker rm -f "$container_name" >/dev/null 2>&1 || true

    docker run -d \
        --name "$container_name" \
        --hostname "rig-${username}" \
        --network "$net_name" \
        --add-host "host.docker.internal:host-gateway" \
        --ipc "private" \
        --memory "$ram" \
        --memory-swap "$ram" \
        --cpus "$cpus" \
        --pids-limit 512 \
        --cap-add NET_ADMIN \
        --device /dev/net/tun:/dev/net/tun \
        -e OPENRIG_SSH_SERVER=true \
        -e OPENRIG_SERVER_TENANT=true \
        -e AUTHORIZED_SSH_KEY="$ssh_key" \
        -p "${port}:22" \
        -v "${user_ws}:/workspace" \
        -v "openrig-home-${username}:/home/rig/.openrig-profiles" \
        "openrig:${role}" >/dev/null

    provision_worker_ai_ticket "$username" || true

    # Record in users.db
    sed -i.bak "/^${username}:/d" "$USERS_DB" 2>/dev/null || true
    rm -f "${USERS_DB}.bak"
    echo "${username}:${port}:${role}:${ram}:${cpus}:$(date +%Y-%m-%d)" >> "$USERS_DB"

    local server_ip
    server_ip=$(ipconfig getifaddr en0 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    [ -z "$server_ip" ] && server_ip="127.0.0.1"

    echo -e "${GREEN}✅ Workstation '${container_name}' active on SSH port ${port}.${RESET}"
    echo ""
    echo -e "${BOLD}📋 Connection command for the developer (on their laptop, zero local Docker needed):${RESET}"
    echo -e "   ${CYAN}rig connect ${server_ip}:${port} openrig-${username}${RESET}"
    echo -e "   (or direct SSH: ${CYAN}ssh -p ${port} rig@${server_ip}${RESET})"
}

cmd_user_list() {
    banner
    echo -e "${BOLD}Provisioned Users & Real-Time Resource Usage:${RESET}\n"
    printf "%-18s %-10s %-14s %-8s %-8s %-20s\n" "USERNAME" "PORT" "ROLE" "RAM LIM" "CPUS" "CONTAINER STATUS"
    echo "----------------------------------------------------------------------------------------"
    while IFS=: read -r user port role ram cpus created; do
        [ -z "$user" ] && continue
        local cname="openrig-user-${user}"
        local st
        st=$(docker inspect -f '{{.State.Status}}' "$cname" 2>/dev/null || echo "not-found")
        printf "%-18s %-10s %-14s %-8s %-8s %-20s\n" "$user" "$port" "$role" "$ram" "$cpus" "$st"
    done < "$USERS_DB"
    echo ""
    docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}" $(docker ps --filter "name=openrig-user-" -q) 2>/dev/null || true
}

cmd_user_action() {
    local act="$1"
    local username="${2:?Missing username}"
    local cname="openrig-user-${username}"
    case "$act" in
        stop)
            docker stop "$cname" >/dev/null
            echo -e "${YELLOW}⏸️  Workstation for '${username}' paused/stopped.${RESET}"
            ;;
        start)
            docker start "$cname" >/dev/null
            echo -e "${GREEN}▶️  Workstation for '${username}' started.${RESET}"
            ;;
        remove|delete)
            docker rm -f "$cname" >/dev/null 2>&1 || true
            docker network rm "openrig-net-${username}" >/dev/null 2>&1 || true
            sed -i.bak "/^${username}:/d" "$USERS_DB" 2>/dev/null || true
            rm -f "${USERS_DB}.bak"
            echo -e "${GREEN}🗑️  Container for '${username}' removed (their code remains backed up in workspaces/${username}).${RESET}"
            ;;
    esac
}

cmd_backup() {
    local username="${1:?Usage: rig-server backup <username>}"
    local ts
    ts=$(date +%Y%m%d_%H%M%S)
    local out="${BACKUPS_DIR}/${username}_workspace_${ts}.tar.gz"
    echo -e "${CYAN}📦 Backing up workspace of '${username}' to ${out}...${RESET}"
    tar -czf "$out" -C "$WORKSPACES_DIR" "$username"
    echo -e "${GREEN}✅ Backup completed: ${out}${RESET}"
}

cmd_scale() {
    local username="${1:?Usage: rig-server scale <username> --ram <e.g. 8g> --cpus <e.g. 4>}"
    shift || true
    local new_ram=""
    local new_cpus=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ram)  new_ram="$2"; shift 2 ;;
            --cpus) new_cpus="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    if [ -z "$new_ram" ] && [ -z "$new_cpus" ]; then
        echo -e "${RED}Usage: rig-server scale <username> --ram <8g> [--cpus <4>]${RESET}"
        exit 1
    fi

    local cname="openrig-user-${username}"
    local update_args=()
    [ -n "$new_ram" ] && update_args+=(--memory "$new_ram" --memory-swap "$new_ram")
    [ -n "$new_cpus" ] && update_args+=(--cpus "$new_cpus")

    echo -e "${CYAN}⚡ Hot-scaling virtual hardware (live update with zero session restart) for '${username}'...${RESET}"
    docker update "${update_args[@]}" "$cname" >/dev/null

    # Update users.db record
    python3 - "$USERS_DB" "$username" "$new_ram" "$new_cpus" << 'PY'
import sys
db_path, user, n_ram, n_cpus = sys.argv[1:]
lines = []
for line in open(db_path).read().splitlines():
    if line.startswith(f"{user}:"):
        parts = line.split(":")
        if n_ram: parts[3] = n_ram
        if n_cpus: parts[4] = n_cpus
        line = ":".join(parts)
    lines.append(line)
open(db_path, "w").write("\n".join(lines) + "\n")
PY

    # Clear pending hardware request if exists
    rm -f "${WORKSPACES_DIR}/${username}/.openrig-hardware-request.json" 2>/dev/null || true

    echo -e "${GREEN}✅ Hardware for '${username}' hot-scaled live (RAM: ${new_ram:-unchanged} | CPUs: ${new_cpus:-unchanged}).${RESET}"
}

cmd_requests() {
    banner
    echo -e "${BOLD}📨 Pending Virtual Hardware Upgrade Requests (submitted by users):${RESET}\n"
    local found=0
    for req in "${WORKSPACES_DIR}"/*/.openrig-hardware-request.json; do
        [ -f "$req" ] || continue
        found=1
        local user
        user=$(basename "$(dirname "$req")")
        python3 - "$user" "$req" << 'PY'
import json, sys
u, p = sys.argv[1], sys.argv[2]
d = json.loads(open(p).read())
print(f"  👤 User: {u}")
print(f"     • Requested: {d.get('requested_ram')} RAM | {d.get('requested_cpus')} CPUs")
print(f"     • Reason:    {d.get('reason')} ({d.get('timestamp')})")
print(f"     👉 Approve & hot-scale live: rig-server scale {u} --ram {d.get('requested_ram')} --cpus {d.get('requested_cpus')}\n")
PY
    done
    [ "$found" -eq 0 ] && echo "  (No pending upgrade requests at the moment)"
    return 0
}

cmd_create_wizard() {
    local username="${1:-}"
    shift || true
    if [ $# -gt 0 ]; then
        # Direct CLI mode: provision + create invite
        cmd_user_create "$username" "$@"
        cmd_invite create --user "$username" "$@"
        return 0
    fi
    banner
    echo -e "${BOLD}🛠️  Server Manager Wizard: Provision New User Workstation Container${RESET}\n"
    [ -z "$username" ] && read -r -p "👤 Username (e.g. carlos): " username
    echo ""
    echo "Select the Skill Profile requested by the user:"
    echo "  1) 🐍 Backend Python     (pyenv, uv, Django, Flask, FastAPI)"
    echo "  2) ☕ Backend JVM        (SDKMAN!, Java 21, Kotlin, Spring Boot, Maven, Gradle)"
    echo "  3) 🎨 Frontend & Web     (nvm, Node, Vue.js, React, Vite)"
    echo "  4) 📱 Mobile & Flutter   (Flutter, Dart, Android SDK CLI)"
    echo "  5) 🛡️  DevSecOps & Pentest(nmap, nuclei, trivy, semgrep, gitleaks, AWS CLI)"
    echo "  6) 🦾 Full-Stack Core    (All languages + Cloud + Security + AI)"
    read -r -p "👉 Role [1-6] (default: 6): " r_choice
    local role="fullstack"
    case "${r_choice:-6}" in
        1) role="backend-python" ;;
        2) role="backend-jvm" ;;
        3) role="frontend" ;;
        4) role="mobile" ;;
        5) role="sec-devops" ;;
        *) role="fullstack" ;;
    esac

    echo ""
    read -r -p "🧠 Assigned Virtual RAM (e.g. 2g, 4g, 8g) [default: 4g]: " ram
    ram="${ram:-4g}"
    read -r -p "⚡ Assigned Virtual CPU Cores (e.g. 1, 2, 4) [default: 2]: " cpus
    cpus="${cpus:-2}"

    cmd_user_create "$username" --role "$role" --ram "$ram" --cpus "$cpus"
    echo ""
    cmd_invite create --user "$username" --role "$role" --ram "$ram" --cpus "$cpus"
}

cmd_invite() {
    local sub="${1:-create}"
    shift || true
    case "$sub" in
        create|add)
            local username=""
            local role="fullstack"
            local ram="4g"
            local cpus="2"
            local ttl_hours=24
            local replace_prev="true"

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --user)    username="$2"; shift 2 ;;
                    --role)    role="$2"; shift 2 ;;
                    --ram)     ram="$2"; shift 2 ;;
                    --cpus)    cpus="$2"; shift 2 ;;
                    --ttl)     ttl_hours="$2"; shift 2 ;;
                    --add-device) replace_prev="false"; shift ;;
                    *) [ -z "$username" ] && username="$1"; shift ;;
                esac
            done

            if [ -z "$username" ]; then
                echo -e "${RED}Usage: rig-server invite create --user <username> [--role fullstack] [--ram 4g] [--cpus 2] [--add-device]${RESET}"
                exit 1
            fi

            # Ensure Gatekeeper is running on port 7070
            if ! lsof -iTCP:7070 -sTCP:LISTEN >/dev/null 2>&1; then
                nohup python3 "${SERVER_DIR}/gatekeeper.py" >/tmp/openrig-gatekeeper.log 2>&1 &
                sleep 1
            fi

            local token
            token="rig_inv_$(openssl rand -hex 16)"
            python3 - "$SERVER_DIR/config/invites.json" "$token" "$username" "$role" "$ram" "$cpus" "$ttl_hours" "$replace_prev" << 'PY'
import json, sys, time
path, token, user, role, ram, cpus, ttl, rep = sys.argv[1:]
data = json.loads(open(path).read() or "{}")
data[token] = {
    "username": user,
    "role": role,
    "ram": ram,
    "cpus": cpus,
    "replace_previous": rep == "true",
    "used": False,
    "created_at": int(time.time()),
    "expires_at": int(time.time()) + int(ttl) * 3600
}
open(path, "w").write(json.dumps(data, indent=2))
PY
            local server_ip
            server_ip=$(ipconfig getifaddr en0 2>/dev/null || echo "127.0.0.1")
            [ -z "$server_ip" ] && server_ip="127.0.0.1"

            echo -e "${GREEN}🎟️  Single-use invitation generated for '${username}' (Expires in ${ttl_hours}h):${RESET}"
            echo -e "   • Role: ${role} | Quota: ${ram} RAM, ${cpus} CPUs | Revokes previous PC: ${replace_prev}"
            echo ""
            echo -e "${BOLD}👉 Share this command with '${username}' to bind their computer:${RESET}"
            echo -e "   ${CYAN}rig join ${server_ip}:7070 --token ${token}${RESET}"
            ;;
        list|ls)
            python3 - "$SERVER_DIR/config/invites.json" << 'PY'
import json, sys
data = json.loads(open(sys.argv[1]).read() or "{}")
print(f"{'TOKEN':<42} {'USERNAME':<14} {'STATUS':<12} {'BOUND DEVICE'}")
print("-" * 86)
for k, v in data.items():
    st = "USED" if v.get("used") else "PENDING"
    dev = f"{v.get('bound_device','-')} ({v.get('bound_hw_id','-')})" if v.get("used") else "-"
    print(f"{k:<42} {v['username']:<14} {st:<12} {dev}")
PY
            ;;
    esac
}

cmd_dlp() {
    local username="${1:?Usage: rig-server dlp <username> --mode [sanitized|approval|airgapped] [--block-terms 'term1,term2']}"
    shift || true
    local mode="sanitized"
    local terms=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mode)        mode="$2"; shift 2 ;;
            --block-terms) terms="$2"; shift 2 ;;
            *) shift ;;
        esac
    done
    local cname="openrig-user-${username}"
    local policy_json
    policy_json=$(python3 - "$username" "$mode" "$terms" << 'PY'
import json, sys
u, m, t = sys.argv[1], sys.argv[2], sys.argv[3]
bl = [x.strip() for x in t.split(",") if x.strip()]
print(json.dumps({"tenant_user": f"rig-{u}", "dlp_mode": m, "blocked_terms": bl}, indent=2))
PY
)
    docker exec -u root "$cname" bash -c "mkdir -p /etc/openrig && cat << 'EOP' > /etc/openrig/dlp-policy.json
${policy_json}
EOP
chown root:root /etc/openrig/dlp-policy.json && chmod 644 /etc/openrig/dlp-policy.json"
    echo -e "${GREEN}🛡️  Enterprise DLP Policy updated for '${username}' (${cname}):${RESET}"
    echo -e "   • DLP Mode:      ${BOLD}${mode}${RESET}"
    echo -e "   • Blocked Terms: ${terms:-none}"
}

cmd_brain_requests() {
    local sub="${1:-list}"
    shift || true
    case "$sub" in
        approve)
            local username="${1:?Usage: rig-server brain-requests approve <username>}"
            local req="${WORKSPACES_DIR}/${username}/.openrig-brain-export.json"
            if [ ! -f "$req" ]; then
                echo -e "${RED}❌ No pending brain export request for '${username}'.${RESET}"
                exit 1
            fi
            local fname content
            fname=$(python3 -c "import json,sys; print(json.loads(open(sys.argv[1]).read())['filename'])" "$req")
            content=$(python3 -c "import json,sys; print(json.loads(open(sys.argv[1]).read())['content'])" "$req")
            docker exec "openrig-user-${username}" bash -c "chmod u+w /dev/shm/.personal-core 2>/dev/null || true; mkdir -p /dev/shm/.personal-core/.outbox && cat << 'EOC' > /dev/shm/.personal-core/.outbox/${fname}
${content}
EOC"
            rm -f "$req"
            echo -e "${GREEN}✅ Brain learning '${fname}' approved for '${username}' and placed in their isolated RAM outbox.${RESET}"
            ;;
        reject)
            local username="${1:?Usage: rig-server brain-requests reject <username>}"
            rm -f "${WORKSPACES_DIR}/${username}/.openrig-brain-export.json"
            echo -e "${YELLOW}🗑️  Brain export request for '${username}' rejected and removed.${RESET}"
            ;;
        *)
            banner
            echo -e "${BOLD}🧠 Pending Enterprise Brain Graduation Requests (DLP Mode = approval):${RESET}\n"
            local found=0
            for req in "${WORKSPACES_DIR}"/*/.openrig-brain-export.json; do
                [ -f "$req" ] || continue
                found=1
                local user
                user=$(basename "$(dirname "$req")")
                python3 - "$user" "$req" << 'PY'
import json, sys
u, p = sys.argv[1], sys.argv[2]
d = json.loads(open(p).read())
print(f"  👤 User: {u} | File: {d.get('filename')} ({d.get('timestamp')})")
print("  ------------------------------------------------------------------------")
for line in d.get("content", "").splitlines()[:12]:
    print(f"    {line}")
print(f"\n  👉 Approve: rig-server brain-requests approve {u}")
print(f"  👉 Reject:  rig-server brain-requests reject {u}\n")
PY
            done
            [ "$found" -eq 0 ] && echo "  (No pending brain graduation requests at the moment)"
            ;;
    esac
}

AI_BROKER_FILE="${SERVER_DIR}/config/ai-broker.json"

provision_worker_ai_ticket() {
    local username="$1"
    local cname="openrig-user-${username}"
    python3 - "$AI_BROKER_FILE" "$username" << 'PY' > /tmp/openrig-ai-env.$$
import json, os, secrets, sys

cfg_path, user = sys.argv[1], sys.argv[2]
if os.path.isfile(cfg_path):
    cfg = json.loads(open(cfg_path).read() or "{}")
else:
    cfg = {"provider": "bedrock", "policy": "hybrid", "region": "us-east-1", "aws_profile": "default", "api_key": "", "upstream_url": "", "tickets": {}}

tickets = cfg.setdefault("tickets", {})
existing_ticket = None
for tk, info in tickets.items():
    if info.get("username") == user:
        existing_ticket = tk
        break

if not existing_ticket:
    existing_ticket = f"rig_ai_ticket_{user}_{secrets.token_hex(12)}"
    tickets[existing_ticket] = {"username": user, "active": True, "requests": 0}

open(cfg_path, "w").write(json.dumps(cfg, indent=2))
os.chmod(cfg_path, 0o600)

prov = cfg.get("provider", "bedrock")
pol = cfg.get("policy", "hybrid")
reg = cfg.get("region", "us-east-1")
print(f'OPENRIG_AI_PROVIDER="{prov}"')
print(f'OPENRIG_AI_POLICY="{pol}"')
print(f'OPENRIG_AI_BROKER_URL="http://host.docker.internal:7070/ai/{prov}"')
print(f'OPENRIG_AI_TICKET="{existing_ticket}"')
print(f'AWS_REGION="{reg}"')
PY
    docker exec -u root "$cname" bash -c "mkdir -p /etc/openrig && cat /dev/stdin > /etc/openrig/ai-corporate.env && chown root:root /etc/openrig/ai-corporate.env && chmod 644 /etc/openrig/ai-corporate.env" < /tmp/openrig-ai-env.$$ 2>/dev/null || true
    rm -f /tmp/openrig-ai-env.$$
}

