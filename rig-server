open(p, "w").write(json.dumps(cfg, indent=2))
PY
            echo -e "${YELLOW}⏸️  Corporate AI Broker access paused for '${username}'.${RESET}"
            ;;
        resume|enable)
            local username="${1:?Usage: rig-server ai resume <username>}"
            python3 - "$AI_BROKER_FILE" "$username" "True" << 'PY'
import json, sys
p, u, st = sys.argv[1], sys.argv[2], sys.argv[3] == "True"
cfg = json.loads(open(p).read())
for tk, info in cfg.get("tickets", {}).items():
    if info.get("username") == u:
        info["active"] = st
open(p, "w").write(json.dumps(cfg, indent=2))
PY
            echo -e "${GREEN}▶️  Corporate AI Broker access resumed for '${username}'.${RESET}"
            ;;
