set -euo pipefail

# Disable Git Bash path mangling on Windows (prevents /dev/net/tun -> C:\Program Files\Git...)
export MSYS_NO_PATHCONV=1
export MSYS2_ARG_CONV_EXCL="*"

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SERVER_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

export PATH="${HOME}/.orbstack/bin:/Applications/OrbStack.app/Contents/MacOS/xbin:/opt/homebrew/bin:/usr/local/bin:$PATH"

WORKSPACES_DIR="${SERVER_DIR}/workspaces"
BACKUPS_DIR="${SERVER_DIR}/backups"
USERS_DB="${SERVER_DIR}/config/users.db"
LOGS_DIR="${SERVER_DIR}/logs"
AUDIT_LOG="${LOGS_DIR}/audit.log"
mkdir -p "$WORKSPACES_DIR" "$BACKUPS_DIR" "${SERVER_DIR}/config" "$LOGS_DIR"
touch "$USERS_DB" "$AUDIT_LOG"

get_admin_identity() {
    local u
    u="$(whoami 2>/dev/null || echo "${USER:-unknown}")"
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "$u" ]; then
        u="${u} (via sudo by ${SUDO_USER})"
    fi
    if [ -n "${SSH_CLIENT:-}" ]; then
        local ip
        ip=$(echo "$SSH_CLIENT" | awk '{print $1}')
        u="${u}@${ip}"
    fi
    echo "$u"
}

log_audit_event() {
    local event="$1"
    local mode="$2"
    local target="$3"
    local details="${4:-}"
    local admin_u
    admin_u="$(get_admin_identity)"
    local srv_h
    srv_h="$(hostname 2>/dev/null || echo "openrig-server")"
    local action_id
    action_id="aud_$(head -c 6 /dev/urandom 2>/dev/null | xxd -p 2>/dev/null || date +%s%N)"
    local ts
    ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%SZ")"

    python3 - "$AUDIT_LOG" "$ts" "$action_id" "$event" "$mode" "$target" "$admin_u" "$srv_h" "$details" << 'PY' 2>/dev/null || true
import json, sys
log_path, ts, aid, ev, md, tgt, adm, host, det = sys.argv[1:10]
entry = {
    "timestamp": ts,
    "action_id": aid,
    "event": ev,
    "mode": md,
    "target_user": tgt,
    "admin_user": adm,
    "server_host": host,
    "details": det
}
with open(log_path, "a", encoding="utf-8") as f:
    f.write(json.dumps(entry) + "\n")
PY
    echo "$action_id"
}

notify_user_container() {
    local cname="$1"
    local mode="$2"
    local admin_u="$3"
    local srv_h="$4"
    local ts
    ts="$(date -u +"%Y-%m-%d %H:%M:%S UTC")"

    if ! docker inspect "$cname" >/dev/null 2>&1; then
        return 0
    fi

    local banner=""
    local tmux_msg=""

    if [ "$mode" = "LIVE_PAIRING_ATTACH" ]; then
        banner="🚨 [OPENRIG SECURITY ALERT]
ADMINISTRATOR ATTACHED TO YOUR SESSION (LIVE PAIR-PROGRAMMING)
Time:       $ts
Admin User: $admin_u
Host:       $srv_h
Mode:       LIVE_PAIRING (Sharing your active terminal/tmux screen in real time)"
        tmux_msg="🚨 [SECURITY ALERT] Admin '${admin_u}' attached to your session in LIVE PAIRING mode ($ts)"
    elif [ "$mode" = "INDEPENDENT_SHELL" ]; then
        banner="⚠️ [OPENRIG AUDIT NOTICE]
ADMINISTRATOR OPENED AN INDEPENDENT TERMINAL IN YOUR WORKSTATION
Time:       $ts
Admin User: $admin_u
Host:       $srv_h
Mode:       INDEPENDENT_SHELL (Parallel background session in /workspace)"
        tmux_msg="⚠️ [SECURITY NOTICE] Admin '${admin_u}' opened an independent shell in your workstation ($ts)"
    elif [ "$mode" = "DISCONNECTED" ]; then
        banner="ℹ️ [OPENRIG AUDIT]
Administrator '${admin_u}' disconnected from your workstation.
Time:       $ts"
        tmux_msg="ℹ️ [SECURITY] Admin '${admin_u}' disconnected ($ts)"
    fi

    # 1. Broadcast via wall to all open pseudo-terminals of the user
    docker exec "$cname" bash -c "echo -e \"$banner\" | wall 2>/dev/null || true" 2>/dev/null || true

    # 2. Display banner in tmux status line if tmux is active
    docker exec "$cname" tmux display-message -d 10000 "$tmux_msg" 2>/dev/null || true

    # 3. Append to user's internal audit log in /workspace/.openrig-audit.log
    docker exec "$cname" bash -c "echo '[$ts] ADMIN_ACCESS: mode=$mode admin=$admin_u host=$srv_h' >> /workspace/.openrig-audit.log 2>/dev/null || true" 2>/dev/null || true
}

get_server_ip() {
    local ip=""
    if command -v ipconfig.exe >/dev/null 2>&1; then
        ip=$(ipconfig.exe | grep -i "IPv4" | awk -F: '{print $2}' | tr -d '\r ' | head -n 1)
    elif command -v cmd.exe >/dev/null 2>&1; then
        ip=$(cmd.exe /c "ipconfig" 2>/dev/null | grep -i "IPv4" | awk -F: '{print $2}' | tr -d '\r ' | head -n 1)
    elif command -v ipconfig >/dev/null 2>&1 && [ "$(uname)" = "Darwin" ]; then
        ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)
    fi
    [ -z "$ip" ] && ip=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "127.0.0.1")
    echo "$ip"
}

get_server_hostname() {
    local h
    h=$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo "openrig-server")
    h=$(echo "$h" | tr -d '\r\n ' | tr '[:upper:]' '[:lower:]')
    echo "${h}.local"
}

get_sockets_dir() {
    local sdir=""
    if [ -d "/run" ] && [ -w "/run" ]; then
        sdir="/run/openrig-sockets"
    elif [ -d "/run/user/$(id -u 2>/dev/null || echo 1000)" ]; then
        sdir="/run/user/$(id -u 2>/dev/null || echo 1000)/openrig-sockets"
    else
        sdir="/tmp/openrig-sockets"
    fi
    mkdir -p "$sdir" 2>/dev/null || sdir="/tmp/openrig-sockets"
    mkdir -p "$sdir" 2>/dev/null || true
    echo "$sdir"
}

get_upstream_docker_sock() {
    local candidates=(
        "/var/run/docker.sock"
        "/mnt/wsl/rancher-desktop/run/docker.sock"
        "${HOME}/.orbstack/run/docker.sock"
        "${HOME}/.docker/run/docker.sock"
        "/var/run/docker/docker.sock"
    )
    for c in "${candidates[@]}"; do
        if [ -S "$c" ]; then
            echo "$c"
            return 0
        fi
    done
    if [ -e "/var/run/docker.sock" ] && [ ! -d "/var/run/docker.sock" ]; then
        echo "/var/run/docker.sock"
        return 0
    fi
    echo ""
}

ensure_docker_proxy() {
    local username="$1"
    local sock_path="$2"
    local sdir
    sdir="$(dirname "$sock_path")"
    local pid_file="${sdir}/${username}.pid"
    if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null && [ -S "$sock_path" ]; then
        return 0
    fi
    mkdir -p "$sdir"
    if [ -d "$sock_path" ]; then
        rm -rf "$sock_path"
    else
        rm -f "$sock_path"
    fi
    rm -f "$pid_file"
    local upstream_sock
    upstream_sock=$(get_upstream_docker_sock)
    DOCKER_HOST_SOCK="$upstream_sock" python3 "${SERVER_DIR}/docker-proxy.py" "$username" "$sock_path" >/dev/null 2>&1 &
    local ppid=$!
    echo "$ppid" > "$pid_file"
    disown 2>/dev/null || true
    for i in {1..20}; do
        [ -S "$sock_path" ] && break
        sleep 0.1
    done
}

ensure_gatekeeper() {
    if docker ps --format '{{.Names}}' | grep -q "^openrig-gatekeeper$"; then
        return 0
    fi
    docker rm -f openrig-gatekeeper >/dev/null 2>&1 || true
    local upstream_sock
    upstream_sock=$(get_upstream_docker_sock)
    local sock_vol=()
    [ -n "$upstream_sock" ] && sock_vol=(-v "${upstream_sock}:/var/run/docker.sock")
    echo -e "${CYAN}🛡️  Starting OpenRig Gatekeeper container on port 7070...${RESET}"
    docker run -d \
        --name openrig-gatekeeper \
        --restart unless-stopped \
        -p 7070:7070 \
        ${sock_vol[@]+"${sock_vol[@]}"} \
        -v "${SERVER_DIR}:/app" \
        -w /app \
        "openrig:fullstack" \
        python3 /app/gatekeeper.py >/dev/null
}

SERVER_VERSION="1.1.0"
[ -f "${SERVER_DIR}/VERSION" ] && SERVER_VERSION=$(cat "${SERVER_DIR}/VERSION" | tr -d '\r\n')

CYAN="\033[96m"
GREEN="\033[92m"
YELLOW="\033[93m"
RED="\033[91m"
BOLD="\033[1m"
RESET="\033[0m"

cmd_version() {
    local git_hash="release"
    if [ -d "${SERVER_DIR}/.git" ] && command -v git >/dev/null 2>&1; then
        git_hash=$(git -C "$SERVER_DIR" rev-parse --short HEAD 2>/dev/null || echo "release")
    fi
    echo -e "${CYAN}${BOLD}🏢 OpenRig-Server v${SERVER_VERSION}${RESET} (${git_hash})"
}

cmd_update() {
    echo -e "${CYAN}🔄 Checking for OpenRig-Server updates...${RESET}"
    if [ ! -d "${SERVER_DIR}/.git" ]; then
        echo -e "${YELLOW}OpenRig-Server was not installed via Git. Updating archive from GitHub...${RESET}"
        local tmp_archive="/tmp/openrig-server-update.tar.gz"
        curl -fsSL -o "$tmp_archive" "https://github.com/LFR-SnowBall/OpenRig-Server/archive/refs/heads/main.tar.gz"
        tar -xzf "$tmp_archive" -C "$SERVER_DIR" --strip-components=1
        rm -f "$tmp_archive"
        [ -f "${SERVER_DIR}/VERSION" ] && SERVER_VERSION=$(cat "${SERVER_DIR}/VERSION" | tr -d '\r\n')
        echo -e "${GREEN}✔ OpenRig-Server updated successfully to v${SERVER_VERSION}!${RESET}"
    else
        git -C "$SERVER_DIR" fetch --tags origin 2>/dev/null || true
        local local_hash remote_hash
        local_hash=$(git -C "$SERVER_DIR" rev-parse HEAD 2>/dev/null || echo "1")
        remote_hash=$(git -C "$SERVER_DIR" rev-parse origin/main 2>/dev/null || echo "2")
        if [ "$local_hash" = "$remote_hash" ]; then
            echo -e "${GREEN}✔ OpenRig-Server is already up to date (v${SERVER_VERSION}).${RESET}"
        else
            echo -e "📥 Pulling latest improvements from GitHub..."
            git -C "$SERVER_DIR" pull --ff-only origin main
            [ -f "${SERVER_DIR}/VERSION" ] && SERVER_VERSION=$(cat "${SERVER_DIR}/VERSION" | tr -d '\r\n')
            echo -e "${GREEN}✔ OpenRig-Server updated successfully to v${SERVER_VERSION}!${RESET}"
        fi
    fi

    # Ensure CLI symlink is active
    if [ -w "/usr/local/bin" ] || sudo -n true 2>/dev/null; then
        sudo ln -sf "${SERVER_DIR}/rig-server" "/usr/local/bin/rig-server" 2>/dev/null || ln -sf "${SERVER_DIR}/rig-server" "/usr/local/bin/rig-server"
    else
        mkdir -p "${HOME}/.local/bin"
        ln -sf "${SERVER_DIR}/rig-server" "${HOME}/.local/bin/rig-server"
    fi
}

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════════════════════╗"
    echo "║   🏢 OPENRIG SERVER — MULTI-TENANT WORKSTATION ORCHESTRATOR              ║"
    echo "║   Created by Luis Fernando Real (@LFR-SnowBall)                          ║"
    echo "╚══════════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
}

next_free_port() {
    local port=2201
    while grep -q ":${port}:" "$USERS_DB" 2>/dev/null || lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; do
        port=$((port + 1))
    done
    echo "$port"
}

cmd_user_create() {
    local username="${1:?Usage: rig-server user create <username> [--role fullstack] [--ram 4g] [--cpus 2] [--port 2201] [--ssh-key '<pubkey>']}"
    shift || true

    local role="fullstack"
    local ram="4g"
    local cpus="2"
    local port
    port=$(next_free_port)
    local ssh_key=""
    local enable_web_ide="true"
    local allow_mobile="false"
    local enable_share="true"
    local allow_admin_attach="true"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --role)    role="$2"; shift 2 ;;
            --ram)     ram="$2"; shift 2 ;;
            --cpus)    cpus="$2"; shift 2 ;;
            --port)    port="$2"; shift 2 ;;
            --ssh-key) ssh_key="$2"; shift 2 ;;
            --no-web-ide|--disable-web-ide) enable_web_ide="false"; shift ;;
            --web-ide) enable_web_ide="$2"; shift 2 ;;
            --allow-mobile) allow_mobile="true"; shift ;;
            --no-mobile)    allow_mobile="false"; shift ;;
            --no-share)     enable_share="false"; shift ;;
            --share)        enable_share="$2"; shift 2 ;;
            --no-admin-attach) allow_admin_attach="false"; shift ;;
            *) shift ;;
        esac
    done

    # Default to host user's public key if none passed
    if [ -z "$ssh_key" ]; then
        if command -v ssh-add >/dev/null 2>&1 && ssh-add -L >/dev/null 2>&1; then
            ssh_key=$(ssh-add -L | head -n 1)
        elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
            ssh_key=$(cat "$HOME/.ssh/id_ed25519.pub")
        fi
    fi

    local container_name="openrig-user-${username}"
    local net_name="openrig-net-${username}"
    local user_ws="${WORKSPACES_DIR}/${username}"
    mkdir -p "$user_ws"

    echo -e "${CYAN}🚀 Provisioning isolated workstation for '${username}' (Role: ${role}, RAM: ${ram}, CPUs: ${cpus}, SSH Port: ${port})...${RESET}"

    docker network inspect "$net_name" >/dev/null 2>&1 || docker network create "$net_name" >/dev/null

    docker rm -f "$container_name" >/dev/null 2>&1 || true

    local tun_opt=()
    if [ -e "/dev/net/tun" ]; then
        tun_opt=(--device /dev/net/tun:/dev/net/tun)
    fi

    local sock_opt=()
    local upstream_sock
    upstream_sock=$(get_upstream_docker_sock)
    if [ -n "$upstream_sock" ]; then
        if [ "${OPENRIG_SCOPED_DOCKER_PROXY:-false}" = "true" ]; then
            local sockets_dir
            sockets_dir=$(get_sockets_dir)
            local user_sock="${sockets_dir}/${username}.sock"
            ensure_docker_proxy "$username" "$user_sock"
            if [ -S "$user_sock" ]; then
                sock_opt=(-v "${user_sock}:/var/run/docker.sock")
            else
                echo -e "${YELLOW}⚠️  Could not bind scoped docker socket '${user_sock}'. Falling back to upstream '${upstream_sock}'...${RESET}"
                sock_opt=(-v "${upstream_sock}:/var/run/docker.sock")
            fi
        else
            echo -e "${GREEN}🐳 Mounting native host Docker socket '${upstream_sock}'...${RESET}"
            sock_opt=(-v "${upstream_sock}:/var/run/docker.sock")
        fi
    fi

    if ! docker image inspect "openrig:${role}" >/dev/null 2>&1; then
        echo -e "${CYAN}🐳 Pre-warmed image 'openrig:${role}' not found locally. Pulling from registry...${RESET}"
        docker pull "ghcr.io/lfr-snowball/openrig:${role}" && docker tag "ghcr.io/lfr-snowball/openrig:${role}" "openrig:${role}" || true
    fi

    docker run -d \
        --init \
        --restart unless-stopped \
        --name "$container_name" \
        --hostname "rig-${username}" \
        --network "$net_name" \
        --add-host "host.docker.internal:host-gateway" \
        --ipc "private" \
        --memory "$ram" \
        --memory-swap "$ram" \
        --cpus "$cpus" \
        --pids-limit 512 \
        --cap-add NET_ADMIN \
        ${tun_opt[@]+"${tun_opt[@]}"} \
        ${sock_opt[@]+"${sock_opt[@]}"} \
        -e OPENRIG_SSH_SERVER=true \
        -e OPENRIG_SERVER_TENANT=true \
        -e OPENRIG_USER="${username}" \
        -e OPENRIG_ENABLE_WEB_IDE="${enable_web_ide}" \
        -e OPENRIG_ALLOW_MOBILE="${allow_mobile}" \
        -e OPENRIG_ENABLE_SHARE="${enable_share}" \
        -e OPENRIG_ALLOW_ADMIN_ATTACH="${allow_admin_attach}" \
        -e COMPOSE_PROJECT_NAME="openrig-${username}" \
        -e AUTHORIZED_SSH_KEY="$ssh_key" \
        -p "${port}:22" \
        -v "${user_ws}:/workspace" \
        -v "openrig-home-${username}:/home/rig/.openrig-profiles" \
        "openrig:${role}" >/dev/null

    provision_worker_ai_ticket "$username" || true

    # Record in users.db
    sed -i.bak "/^${username}:/d" "$USERS_DB" 2>/dev/null || true
    rm -f "${USERS_DB}.bak"
    echo "${username}:${port}:${role}:${ram}:${cpus}:$(date +%Y-%m-%d)" >> "$USERS_DB"

    local server_ip
    server_ip=$(get_server_ip)

    echo -e "${GREEN}✅ Workstation '${container_name}' active on SSH port ${port}.${RESET}"
    echo ""
    echo -e "${BOLD}📋 Connection command for the developer (on their laptop, zero local Docker needed):${RESET}"
    echo -e "   ${CYAN}rig connect ${server_ip}:${port} openrig-${username}${RESET}"
    echo -e "   (or direct SSH: ${CYAN}ssh -p ${port} rig@${server_ip}${RESET})"
}

cmd_user_list() {
    banner
    echo -e "${BOLD}Provisioned Users & Real-Time Resource Usage:${RESET}\n"
    printf "%-18s %-10s %-14s %-8s %-8s %-20s\n" "USERNAME" "PORT" "ROLE" "RAM LIM" "CPUS" "CONTAINER STATUS"
    echo "----------------------------------------------------------------------------------------"
    while IFS=: read -r user port role ram cpus created; do
        [ -z "$user" ] && continue
        local cname="openrig-user-${user}"
        local st
        st=$(docker inspect -f '{{.State.Status}}' "$cname" 2>/dev/null || echo "not-found")
        printf "%-18s %-10s %-14s %-8s %-8s %-20s\n" "$user" "$port" "$role" "$ram" "$cpus" "$st"
    done < "$USERS_DB"
    echo ""
    docker stats --no-stream --format "table {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.NetIO}}" $(docker ps --filter "name=openrig-user-" -q) 2>/dev/null || true
}

cmd_user_action() {
    local act="$1"
    local username="${2:?Missing username}"
    local cname="openrig-user-${username}"
    local admin_u
    admin_u="$(get_admin_identity)"
    local srv_h
    srv_h="$(hostname 2>/dev/null || echo "openrig-server")"

    case "$act" in
        enter|shell)
            local aid
            aid=$(log_audit_event "ADMIN_SESSION_ACCESS" "INDEPENDENT_SHELL" "$username" "Interactive terminal opened by admin")
            echo -e "${YELLOW}🔒 [OpenRig Audit] Access logged (ID: ${BOLD}${aid}${RESET}${YELLOW}).${RESET}"
            echo -e "${CYAN}📢 Notifying user '${username}' of administrative shell access...${RESET}"
            notify_user_container "$cname" "INDEPENDENT_SHELL" "$admin_u" "$srv_h"
            
            docker exec -it -u rig -w /workspace "$cname" zsh -l || true
            
            log_audit_event "ADMIN_SESSION_EXIT" "INDEPENDENT_SHELL" "$username" "Interactive terminal closed (ref: ${aid})"
            notify_user_container "$cname" "DISCONNECTED" "$admin_u" "$srv_h"
            ;;
        attach|watch)
            local allow_att
            allow_att=$(docker inspect "$cname" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | grep -E '^OPENRIG_ALLOW_ADMIN_ATTACH=' | cut -d= -f2 || echo "true")
            if [ "$allow_att" = "false" ]; then
                echo -e "${RED}🚫 Live pair-programming attach is disabled for user '${username}' by workstation security policy (OPENRIG_ALLOW_ADMIN_ATTACH=false).${RESET}"
                return 1
            fi
            local aid
            aid=$(log_audit_event "ADMIN_SESSION_ACCESS" "LIVE_PAIRING_ATTACH" "$username" "Admin attached to live tmux session")
            echo -e "${YELLOW}🔒 [OpenRig Audit] Access logged (ID: ${BOLD}${aid}${RESET}${YELLOW}).${RESET}"
            echo -e "${CYAN}📢 Notifying user '${username}' of live pair-programming attach...${RESET}"
            notify_user_container "$cname" "LIVE_PAIRING_ATTACH" "$admin_u" "$srv_h"
            
            if docker exec "$cname" tmux has-session -t openrig >/dev/null 2>&1; then
                docker exec -it -u rig "$cname" tmux attach-session -t openrig || true
            else
                echo -e "${YELLOW}⚠️  No active 'openrig' tmux session found in '${cname}'. Opening an independent shell instead...${RESET}"
                docker exec -it -u rig -w /workspace "$cname" zsh -l || true
            fi
            
            log_audit_event "ADMIN_SESSION_EXIT" "LIVE_PAIRING_ATTACH" "$username" "Admin detached from session (ref: ${aid})"
            notify_user_container "$cname" "DISCONNECTED" "$admin_u" "$srv_h"
            ;;
        stop)
            log_audit_event "ADMIN_WORKSTATION_CONTROL" "STOP" "$username" "Workstation container stopped by admin"
            local sdir
            sdir=$(get_sockets_dir)
            local pid_file="${sdir}/${username}.pid"
            if [ -f "$pid_file" ]; then
                kill -9 "$(cat "$pid_file" 2>/dev/null)" 2>/dev/null || true
                rm -f "$pid_file" "${sdir}/${username}.sock"
            fi
            docker stop "$cname" >/dev/null
            echo -e "${YELLOW}⏸️  Workstation for '${username}' paused/stopped.${RESET}"
            ;;
        start)
            log_audit_event "ADMIN_WORKSTATION_CONTROL" "START" "$username" "Workstation container started by admin"
            local upstream_sock
            upstream_sock=$(get_upstream_docker_sock)
            if [ -n "$upstream_sock" ]; then
                local sdir
                sdir=$(get_sockets_dir)
                ensure_docker_proxy "$username" "${sdir}/${username}.sock"
            fi
            docker start "$cname" >/dev/null
            echo -e "${GREEN}▶️  Workstation for '${username}' started.${RESET}"
            ;;
        recreate|reload)
            log_audit_event "ADMIN_WORKSTATION_CONTROL" "RECREATE" "$username" "Workstation container recreated by admin"
            local entry
            entry=$(grep -E "^${username}:" "$USERS_DB" | tail -n 1 || true)
            local port="2202" role="fullstack" ram="4g" cpus="2"
            if [ -n "$entry" ]; then
                port=$(echo "$entry" | cut -d: -f2)
                role=$(echo "$entry" | cut -d: -f3)
                ram=$(echo "$entry" | cut -d: -f4)
                cpus=$(echo "$entry" | cut -d: -f5)
            fi
            local saved_keys_file="${SERVER_DIR}/config/keys/${username}.keys"
            mkdir -p "${SERVER_DIR}/config/keys"
            if docker inspect "$cname" >/dev/null 2>&1; then
                docker exec -u root "$cname" cat /etc/openrig/authorized_keys > "$saved_keys_file" 2>/dev/null || true
            fi
            echo -e "${CYAN}🔄 Recreating workstation for '${username}' with native Docker socket...${RESET}"
            docker rm -f "$cname" >/dev/null 2>&1 || true
            cmd_user_create "$username" --role "$role" --ram "$ram" --cpus "$cpus" --port "$port"
            if [ -s "$saved_keys_file" ]; then
                docker exec -u root "$cname" mkdir -p /etc/openrig
                docker cp "$saved_keys_file" "${cname}:/etc/openrig/authorized_keys"
                docker exec -u root "$cname" chown root:root /etc/openrig/authorized_keys
                docker exec -u root "$cname" chmod 644 /etc/openrig/authorized_keys
            fi
            echo -e "${GREEN}✔ Workstation '${cname}' successfully recreated with Docker socket active.${RESET}"
            ;;
        sessions|history|log)
            local ulog="${WORKSPACES_DIR}/${username}/.openrig-sessions.log"
            banner
