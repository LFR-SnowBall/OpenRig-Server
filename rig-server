cmd_audit() {
    local limit="25"
    local filter_user=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --user|-u) filter_user="$2"; shift 2 ;;
            *) [[ "$1" =~ ^[0-9]+$ ]] && limit="$1"; shift ;;
        esac
    done

    banner
    local title="🛡️  OpenRig-Server Immutable Admin Audit Trail (Last ${limit} Events"
    [ -n "$filter_user" ] && title="${title} for '${filter_user}'"
    echo -e "${BOLD}${title}):${RESET}\n"

    if [ ! -f "$AUDIT_LOG" ] || [ ! -s "$AUDIT_LOG" ]; then
        echo "  (No audit events recorded yet in logs/audit.log)"
        return 0
    fi
    python3 - "$AUDIT_LOG" "$limit" "$filter_user" << 'PY'
import json, sys
p, limit_str, filter_user = sys.argv[1], sys.argv[2], sys.argv[3]
limit = int(limit_str)
lines = [l.strip() for l in open(p, encoding='utf-8') if l.strip()]
if not lines:
    print("  (Audit log is empty)")
    sys.exit(0)

filtered = []
for line in lines:
    try:
        d = json.loads(line)
        if filter_user and d.get('target_user', '') != filter_user:
            continue
        filtered.append(d)
    except Exception:
        continue

if not filtered:
    print(f"  (No audit records found matching user '{filter_user}')")
    sys.exit(0)

print(f"  {'TIMESTAMP':<20} {'EVENT':<24} {'TARGET':<12} {'ADMIN':<18} {'MODE':<20} {'DETAILS'}")
print("  " + "-" * 115)
for d in filtered[-limit:]:
    ts = d.get('timestamp', '')[:19].replace('T', ' ')
    ev = d.get('event', '-')
    tgt = d.get('target_user', '-')
    adm = d.get('admin_user', '-')
    md = d.get('mode', '-')
    det = d.get('details', '')
    print(f"  {ts:<20} {ev:<24} {tgt:<12} {adm:<18} {md:<20} {det}")
print("")
PY
}

